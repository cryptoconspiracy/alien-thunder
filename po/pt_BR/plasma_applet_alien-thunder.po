#: plasma/alien-thunder/contents/ui/main.qml:261
msgid ""
"No readings: the alien-thunder service isn't running. Start it with: "
"systemctl --user start alien-thunder"
msgstr ""
"Sem leituras: o serviço alien-thunder não está rodando. Inicie com: "
"systemctl --user start alien-thunder"

#: plasma/alien-thunder/contents/ui/main.qml:298
msgid "G-Mode"
msgstr "G-Mode"

#: plasma/alien-thunder/contents/ui/main.qml:300
msgid "Fans at full speed and the performance power profile. Same as Fn+F1."
msgstr ""
"Ventoinhas no máximo e perfil de energia performance. O mesmo que Fn+F1."

#: plasma/alien-thunder/contents/ui/main.qml:318
msgid "Overlay"
msgstr "Sobreposição"

#: plasma/alien-thunder/contents/ui/main.qml:320
msgid ""
"A bar of readouts above every window, games included. Drag it anywhere, on "
"any screen; its ✕ turns it off."
msgstr ""
"Uma barra de mostradores acima de todas as janelas, inclusive jogos. Arraste "
"para qualquer lugar, em qualquer tela; o ✕ dela desliga."

