#: alien_thunder/cli.py:14
msgid ""
"alien-thunder                    open the lighting editor\n"
"alien-thunder list               list the profiles (* = active)\n"
"alien-thunder set <profile>      make a profile the active one and apply it\n"
"alien-thunder apply [profile]    apply now (default: the active one) without "
"changing it\n"
"alien-thunder status             service and device status\n"
"alien-thunder power [profile]    write the power button colors now\n"
"alien-thunder gmode [on|off|toggle]\n"
"                                 G-Mode, the same as Fn+F1; with no "
"argument, show it\n"
"alien-thunder overlay [on|off|show ITEM|hide ITEM|status]\n"
"                                 the floating readout bar\n"
"alien-thunder import-windows [--list | --id N ...]\n"
"                                 import AWCC presets from /mnt/windows\n"
"alien-thunder setup              per-user setup after installing a package\n"
"alien-thunder daemon             the service (started by systemd --user)"
msgstr ""
"alien-thunder                    abre o editor de iluminação\n"
"alien-thunder list               lista os perfis (* = ativo)\n"
"alien-thunder set <perfil>       torna o perfil ativo e aplica\n"
"alien-thunder apply [perfil]     aplica agora (padrão: o ativo) sem mudar o "
"ativo\n"
"alien-thunder status             estado do serviço e dos dispositivos\n"
"alien-thunder power [perfil]     grava agora as cores do botão de energia\n"
"alien-thunder gmode [on|off|toggle]\n"
"                                 G-Mode, o mesmo que Fn+F1; sem argumento, "
"mostra o estado\n"
"alien-thunder overlay [on|off|show ITEM|hide ITEM|status]\n"
"                                 a barra flutuante de mostradores\n"
"alien-thunder import-windows [--list | --id N ...]\n"
"                                 importa predefinições do AWCC de /mnt/"
"windows\n"
"alien-thunder setup              ajustes por usuário depois de instalar um "
"pacote\n"
"alien-thunder daemon             o serviço (iniciado pelo systemd --user)"

